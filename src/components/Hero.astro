---
interface Props {
  title: string;
  subtitle?: string;
  tagline?: string;
  ctaText?: string;
  ctaHref?: string;
  backgroundImage?: string;
  height?: string;
  bgPosition?: string;
}

const {
  title,
  subtitle,
  tagline,
  ctaText,
  ctaHref = "#",
  backgroundImage = "",
  height = "h-[80vh]",
  bgPosition = "",
} = Astro.props;
---

<section class={`relative ${height} w-full overflow-hidden`}>
  {
    backgroundImage && (
      <div
        class={`absolute inset-0 bg-cover ${bgPosition || 'bg-top'}`}
        style={`background-image: linear-gradient(rgba(33, 21, 17, 0.4), rgba(33, 21, 17, 0.2)), url("${backgroundImage}");`}
      />
    )
  }
  <div
    class="relative h-full flex flex-col items-center justify-center text-center px-6"
  >
    <div class="max-w-4xl space-y-6">
      <h1
        class="text-white text-5xl md:text-7xl font-extrabold leading-tight tracking-tight drop-shadow-lg"
      >
        {title}
      </h1>
      {
        (subtitle || tagline) && (
          <div class="space-y-2">
            {subtitle && (
              <p class="text-white text-xl md:text-2xl font-light italic">
                {subtitle}
              </p>
            )}
            {tagline && (
              <p class="text-white/90 text-sm md:text-base tracking-[0.2em] uppercase font-medium">
                {tagline}
              </p>
            )}
          </div>
        )
      }
      {
        ctaText && (
          <div class="pt-8">
            <a
              href={ctaHref}
              class="inline-block px-8 py-4 bg-primary text-white rounded-full font-bold text-lg hover:bg-white hover:text-primary transition-all shadow-xl no-underline"
            >
              {ctaText}
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

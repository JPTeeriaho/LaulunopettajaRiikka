---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.lang === "fi");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} — Riikka Vuorijärvi`}>
  <Nav currentPage="blogi" />

  <!-- Hero -->
  <section class="relative w-full h-[50vh] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-[#211511]/70 to-transparent z-10"></div>
    <div
      class="absolute inset-0 bg-center bg-cover scale-105"
      style={`background-image: url('${post.data.image}');`}
    ></div>
    <div class="relative z-20 max-w-3xl mx-auto w-full px-6 md:px-10 pb-16">
      <span class="inline-block text-primary bg-white/90 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-4">
        {post.data.category}
      </span>
      <h1 class="text-white text-4xl md:text-5xl font-extrabold tracking-tight leading-tight">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-2 text-white/70 mt-4 text-sm">
        <span class="material-symbols-outlined text-sm">calendar_today</span>
        <span>{post.data.date}</span>
      </div>
    </div>
  </section>

  <!-- Blog Content -->
  <article class="max-w-3xl mx-auto px-6 md:px-10 py-16">
    <div class="prose prose-lg prose-slate max-w-none
      prose-headings:text-slate-900 prose-headings:font-bold
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-img:rounded-xl prose-img:shadow-md">
      <Content />
    </div>
  </article>

  <!-- Back link -->
  <div class="max-w-3xl mx-auto px-6 md:px-10 pb-16">
    <a
      href="/blogi"
      class="inline-flex items-center gap-2 text-primary font-bold hover:gap-3 transition-all no-underline"
    >
      <span class="material-symbols-outlined">arrow_back</span>
      Takaisin blogiin
    </a>
  </div>

  <Footer />
</BaseLayout>

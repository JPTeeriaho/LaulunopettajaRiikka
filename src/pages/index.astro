---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Footer from "../components/Footer.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import pageData from "../data/home-fi.json";
---

<BaseLayout title="Riikka Vuorijärvi | Äänesi rinnallakulkija" description={pageData.seoDescription} lang="fi" alternateLang="/en/">
  <Nav currentPage="koti" />

  <!-- Hero -->
  <Hero
    title={pageData.hero.title}
    subtitle={pageData.hero.subtitle}
    ctaText={pageData.hero.ctaText}
    ctaHref={pageData.hero.ctaHref}
    backgroundImage={pageData.images.hero}
    bgPosition="bg-[50%_top] md:bg-top"
  />

  <!-- Intro Content -->
  <section class="py-20 px-6 md:px-20 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="space-y-8">
        <h2 class="text-3xl md:text-4xl font-bold text-accent-wine">
          {pageData.intro.heading}
        </h2>
        <div class="space-y-6 text-lg leading-relaxed text-slate-700">
          <p>
            {pageData.intro.text}
          </p>
          <p>
            <strong>{pageData.intro.note.split(" ")[0]}</strong> {pageData.intro.note.substring(pageData.intro.note.indexOf(" ") + 1)}
          </p>
        </div>
        <div class="flex gap-4">
          <a
            class="inline-flex items-center gap-2 text-primary font-bold hover:underline"
            href={pageData.intro.readMoreHref}
          >
            {pageData.intro.readMoreText}
            <span class="material-symbols-outlined">arrow_forward</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-4">
          <div
            class="h-64 rounded-2xl overflow-hidden shadow-lg transform translate-y-8"
          >
            <OptimizedImage
              alt="Eila estradilla"
              class="w-full h-full object-cover object-top"
              src={pageData.images.introImg1}
            />
          </div>
          <div
            class="h-48 rounded-2xl overflow-hidden shadow-lg bg-accent-green/20 flex items-center justify-center p-8 text-center italic text-accent-green font-medium"
          >
            "{pageData.intro.quoteText}"
          </div>
        </div>
        <div class="space-y-4">
          <div
            class="h-48 rounded-2xl overflow-hidden shadow-lg"
          >
            <OptimizedImage
              alt="Kalle eläytyy"
              class="w-full h-full object-cover"
              src={pageData.images.introImg3}
            />
          </div>
          <div class="h-64 rounded-2xl overflow-hidden shadow-lg">
            <OptimizedImage
              alt="Minna eläytyy"
              class="w-full h-full object-cover"
              src={pageData.images.introImg2}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Preview -->
  <section class="py-24 bg-neutral-beige/30">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16 space-y-4">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 italic">
          {pageData.testimonialPreview.heading}
        </h2>
        <div class="w-24 h-1 bg-primary/30 mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {
          pageData.testimonialPreview.cards.map((card) => (
            <TestimonialCard
              quote={card.quote}
              author={card.author}
              role={card.role}
              icon={card.icon}
            />
          ))
        }
      </div>
      <div class="text-center mt-12">
        <a
          href={pageData.testimonialPreview.readMoreHref}
          class="inline-flex items-center gap-2 text-primary font-bold text-lg hover:underline"
        >
          {pageData.testimonialPreview.readMoreText}
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

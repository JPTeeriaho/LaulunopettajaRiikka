---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import TestimonialCard from "../../components/TestimonialCard.astro";
import Footer from "../../components/Footer.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { getCollection } from "astro:content";
import pageData from "../../data/palautteet-en.json";

const longTestimonials = (await getCollection("testimonials", ({ data }) => data.lang === "en" && data.type === "long"))
  .sort((a, b) => a.data.order - b.data.order);

const improTestimonials = (await getCollection("testimonials", ({ data }) => data.lang === "en" && data.type === "impro"))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Testimonials — Riikka Vuorijärvi" description={pageData.seoDescription} lang="en" alternateLang="/palautteet/">
  <Nav currentPage="palautteet" lang="en" />

  <!-- Hero -->
  <Hero
    title={pageData.hero.title}
    subtitle={pageData.hero.subtitle}
    ctaText={pageData.hero.ctaText}
    ctaHref={pageData.hero.ctaHref}
    height="h-[60vh]"
    backgroundImage={pageData.images.hero}
  />

  <!-- Video embeds -->
  <section class="max-w-5xl mx-auto px-6 pt-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        pageData.videoLinks.map((link) => {
          const videoId = new URL(link.url).searchParams.get('v');
          return (
            <div class="space-y-3">
              <div class="relative w-full aspect-video rounded-xl overflow-hidden shadow-lg">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${videoId}`}
                  title={link.text}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  class="absolute inset-0 w-full h-full"
                />
              </div>
              <p class="text-sm text-slate-600 text-center font-medium">{link.text}</p>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Long-form testimonials -->
  <section class="max-w-4xl mx-auto px-6 py-20" id="experiences">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-extrabold text-slate-900 mb-4">
        {pageData.longSectionTitle}
      </h2>
      <div class="h-1.5 w-24 bg-terracotta mx-auto rounded-full"></div>
    </div>

    <!-- Decorative landscape image -->
    <div class="max-w-2xl mx-auto mb-16 rounded-xl overflow-hidden shadow-lg hidden md:block">
      <OptimizedImage src={pageData.images.decorative1} alt="Toivo and Kalle" class="w-full h-auto object-cover" />
    </div>

    <div class="space-y-12">
      {
        longTestimonials.map((t, i) => (
          <>
            <TestimonialCard
              quote={t.body}
              author={t.data.author}
              variant="full"
            />
            {i === 1 && (
              <div class="max-w-2xl mx-auto rounded-xl overflow-hidden shadow-lg hidden md:block">
                <OptimizedImage src={pageData.images.decorative2} alt="Toivo playing" class="w-full h-auto object-cover" />
              </div>
            )}
          </>
        ))
      }
    </div>
  </section>

  <!-- Voice impro testimonials -->
  <section class="bg-sage/5 py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-8">
        <h2 class="text-4xl font-extrabold text-slate-900 mb-4">
          {pageData.improSectionTitle}
        </h2>
        <div class="h-1.5 w-24 bg-sage mx-auto rounded-full"></div>
      </div>
      <p
        class="text-center text-slate-600 max-w-2xl mx-auto mb-16 text-lg leading-relaxed"
      >
        {pageData.improIntro}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          improTestimonials.map((t) => (
            <div class="bg-white p-8 rounded-xl shadow-sm border border-sage/10">
              <p class="italic text-slate-700 mb-6">
                &ldquo;{t.body}&rdquo;
              </p>
              <p class="font-bold text-sage">{t.data.author}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary/5 py-16 px-6 lg:px-40 text-center">
    <div class="max-w-2xl mx-auto flex flex-col gap-6">
      <h2 class="text-2xl font-bold text-slate-900">
        {pageData.cta.heading}
      </h2>
      <p class="text-slate-600">
        {pageData.cta.text}
      </p>
      <div class="flex justify-center gap-4 pt-2">
        <a
          href={pageData.cta.buttonHref}
          class="flex min-w-[180px] cursor-pointer items-center justify-center rounded-lg h-12 px-6 bg-primary text-white text-base font-bold shadow-md hover:bg-primary/90 transition-colors no-underline"
        >
          {pageData.cta.buttonText}
        </a>
      </div>
    </div>
  </section>

  <Footer lang="en" />
</BaseLayout>

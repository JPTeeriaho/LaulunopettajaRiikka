---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import Footer from "../../components/Footer.astro";
import pageData from "../../data/hinnat-en.json";
import pricingData from "../../data/pricing-en.json";
import mapsData from "../../data/maps-embed.json";
---

<BaseLayout title="Pricing & Contact — Riikka Vuorijärvi">
  <Nav currentPage="hinnat" lang="en" />

  <!-- Hero -->
  <Hero
    title={pageData.hero.title}
    subtitle={pageData.hero.subtitle}
    ctaText={pageData.hero.ctaText}
    ctaHref={pageData.hero.ctaHref}
    height="h-[50vh]"
    backgroundImage={pageData.images.hero}
  />

  <div
    class="max-w-[960px] min-[1920px]:max-w-[1200px] min-[2560px]:max-w-[1600px] w-full mx-auto px-4 md:px-6 flex flex-col gap-12 py-12"
  >
    <!-- Pricing Table -->
    <section class="flex flex-col gap-6" id="pricing">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">payments</span>
        <h2 class="text-slate-900 text-2xl font-bold leading-tight">
          {pricingData.tableTitle}
        </h2>
      </div>

      <div
        class="overflow-hidden rounded-xl border border-primary/10 bg-white shadow-sm"
      >
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-primary/5">
              <th
                class="px-6 py-4 text-slate-900 text-sm font-bold border-b border-primary/10"
                >{pricingData.tableHeaders.service}</th
              >
              <th
                class="px-6 py-4 text-slate-900 text-sm font-bold border-b border-primary/10"
                >{pricingData.tableHeaders.duration}</th
              >
              <th
                class="px-6 py-4 text-slate-900 text-sm font-bold border-b border-primary/10"
                >{pricingData.tableHeaders.price}</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-primary/5">
            {
              pricingData.items.map((item) => (
                <tr class="hover:bg-primary/5 transition-colors">
                  <td class="px-6 py-5 text-slate-800">
                    <div class="font-medium">{item.name}</div>
                  </td>
                  <td class="px-6 py-5 text-slate-600 text-sm">
                    {item.duration}
                  </td>
                  <td class="px-6 py-5 text-primary font-bold">
                    {item.price}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-slate-500 text-sm">
        {pricingData.footnote}
      </p>
    </section>

    <!-- Booking CTA -->
    <section
      class="rounded-xl border border-primary/20 bg-primary/5 p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6"
    >
      <div class="flex flex-col gap-2 text-center md:text-left md:max-w-[70%]">
        <h3 class="text-slate-900 text-xl font-bold">
          {pageData.booking.heading}
        </h3>
        <p class="text-slate-600">
          {pageData.booking.text}
        </p>
      </div>
      <a
        href={pageData.booking.buttonHref}
        class="flex shrink-0 whitespace-nowrap cursor-pointer items-center justify-center rounded-lg h-12 px-6 bg-primary text-white font-bold hover:scale-105 transition-transform shadow-lg shadow-primary/20 no-underline"
      >
        <span class="material-symbols-outlined mr-2">calendar_month</span>
        {pageData.booking.buttonText}
      </a>
    </section>

    <!-- Contact and Location Grid -->
    <section class="grid md:grid-cols-2 gap-8" id="contact">
      <!-- Location -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary"
            >location_on</span
          >
          <h2 class="text-slate-900 text-xl font-bold">
            {pageData.location.heading}
          </h2>
        </div>
        <div
          class="bg-white p-4 rounded-xl border border-primary/10 flex flex-col gap-4 shadow-sm"
        >
          <div>
            <p class="font-bold text-slate-800">
              {pageData.location.name}
            </p>
            <p class="text-slate-600">{pageData.location.street}</p>
            <p class="text-slate-600">{pageData.location.city}</p>
            <p class="text-sm text-slate-500 italic mt-1">
              {pageData.location.note}
            </p>
          </div>
          <div
            class="w-full h-48 rounded-lg overflow-hidden bg-slate-100 relative"
          >
            <iframe
              src={mapsData.src}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Teaching location on map"></iframe>
          </div>
        </div>
      </div>

      <!-- Contact Details -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary"
            >contact_support</span
          >
          <h2 class="text-slate-900 text-xl font-bold">
            {pageData.contact.heading}
          </h2>
        </div>
        <div
          class="bg-white p-6 rounded-xl border border-primary/10 flex flex-col gap-6 shadow-sm h-full"
        >
          <div class="flex items-start gap-4">
            <div
              class="size-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0"
            >
              <span class="material-symbols-outlined text-primary">call</span>
            </div>
            <div>
              <p
                class="text-xs font-bold uppercase tracking-wider text-slate-400"
              >
                {pageData.contact.phoneLabel}
              </p>
              <a
                class="text-lg font-medium text-slate-800 hover:text-primary"
                href={`tel:${pageData.contact.phoneFull}`}>{pageData.contact.phone}</a
              >
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div
              class="size-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0"
            >
              <span class="material-symbols-outlined text-primary">mail</span>
            </div>
            <div>
              <p
                class="text-xs font-bold uppercase tracking-wider text-slate-400"
              >
                {pageData.contact.emailLabel}
              </p>
              <a
                class="text-lg font-medium text-slate-800 hover:text-primary break-all"
                href={`mailto:${pageData.contact.email}`}
                >{pageData.contact.email}</a
              >
            </div>
          </div>
          <hr class="border-primary/10">
          <div>
            <p
              class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
            >
              {pageData.contact.billingLabel}
            </p>
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span
                  class="material-symbols-outlined text-slate-400 text-sm"
                  >corporate_fare</span
                >
                <p class="text-sm text-slate-600">
                  {pageData.contact.billingCompany}
                </p>
              </div>
              <div class="flex items-center gap-2">
                <span
                  class="material-symbols-outlined text-slate-400 text-sm"
                  >call</span
                >
                <a
                  class="text-sm text-slate-600 hover:text-primary"
                  href={`tel:${pageData.contact.billingPhoneFull}`}>{pageData.contact.billingPhone}</a
                >
              </div>
              <div class="flex items-center gap-2">
                <span
                  class="material-symbols-outlined text-slate-400 text-sm"
                  >mail</span
                >
                <a
                  class="text-sm text-slate-600 hover:text-primary"
                  href={`mailto:${pageData.contact.billingEmail}`}>{pageData.contact.billingEmail}</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Footer lang="en" />
</BaseLayout>

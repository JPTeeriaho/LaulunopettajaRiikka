---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { getCollection } from "astro:content";
import blogData from "../../data/blogi-en.json";

const posts = (await getCollection("blog", ({ data }) => data.lang === "en"))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="Blog — Riikka Vuorijärvi" description={blogData.seoDescription} lang="en" alternateLang="/blogi/">
  <Nav currentPage="blogi" lang="en" />

  <!-- Hero -->
  <section class="relative w-full h-[400px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#211511]/60 to-transparent z-10"
    >
    </div>
    <OptimizedImage
      src={blogData.hero.backgroundImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-top scale-105"
      loading="eager"
    />
    <div class="relative z-20 max-w-7xl mx-auto w-full px-6 md:px-10 pb-16">
      <h2 class="text-white text-5xl md:text-7xl font-extrabold tracking-tight">
        {blogData.hero.title}
      </h2>
      <p class="text-white/80 mt-4 max-w-xl text-lg font-light leading-relaxed">
        {blogData.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {
        posts.map((post) => (
          <article class="group flex flex-col bg-white rounded-xl overflow-hidden border border-primary/5 shadow-sm hover:shadow-xl transition-all duration-300">
            <div class="aspect-video w-full overflow-hidden">
              <OptimizedImage
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <span class="text-primary text-xs font-bold uppercase tracking-widest mb-2">
                {post.data.category}
              </span>
              <h3 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors line-clamp-2">
                {post.data.title}
              </h3>
              <div class="flex items-center gap-2 text-slate-500 text-sm mb-4">
                <span class="material-symbols-outlined text-sm">
                  calendar_today
                </span>
                <span>{post.data.date}</span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-grow">
                {post.data.excerpt}
              </p>
              <a
                class="inline-flex items-center gap-2 text-primary font-bold text-sm hover:gap-3 transition-all"
                href={`/en/blog/${post.id.replace(/\.md$/, "")}`}
              >
                {blogData.readMoreText}
                <span class="material-symbols-outlined text-base">
                  arrow_forward
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <Footer lang="en" />
</BaseLayout>

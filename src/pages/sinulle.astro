---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import pageData from "../data/sinulle-fi.json";

const services = (await getCollection("services", ({ data }) => data.lang === "fi"))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Sinulle? — Riikka Vuorijärvi">
  <Nav currentPage="sinulle" />

  <!-- Hero -->
  <Hero
    title={pageData.hero.title}
    subtitle={pageData.hero.subtitle}
    ctaText={pageData.hero.ctaText}
    ctaHref={pageData.hero.ctaHref}
    height="h-[50vh]"
    backgroundImage={pageData.images.hero}
  />

  <!-- Services Grid -->
  <section class="max-w-[1200px] min-[1920px]:max-w-[1600px] min-[2560px]:max-w-[2000px] mx-auto px-6 lg:px-20 py-16" id="palvelut">
    <div class="mb-12 text-center">
      <h2 class="text-3xl font-extrabold text-slate-900 mb-4 lg:text-4xl">
        {pageData.sectionHeading}
      </h2>
      <div class="w-20 h-1 bg-primary mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20 justify-items-center">
      {
        services.map((service) => (
          <div class="flex flex-col gap-5 p-6 rounded-xl bg-white border border-primary/5 hover:border-primary/20 transition-all shadow-sm hover:shadow-md group">
            <div class="w-full aspect-video rounded-lg overflow-hidden">
              <img
                src={service.data.image}
                alt={service.data.title}
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="text-center">
              <h3 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-primary transition-colors">
                {service.data.title}
              </h3>

              <p class="text-slate-600 text-sm leading-relaxed">
                {service.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Why Riikka -->
    <div
      class="flex flex-col lg:flex-row gap-12 items-center bg-primary/5 p-8 lg:p-16 rounded-3xl border border-primary/10"
    >
      <div class="lg:w-1/2 flex gap-4">
        <div class="w-1/2 aspect-[4/5] rounded-2xl rotate-[-2deg] shadow-xl overflow-hidden">
          <img
            src={pageData.images.whyRiikka1}
            alt="Riikka Vuorijärvi"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="w-1/2 aspect-[4/5] rounded-2xl rotate-[2deg] shadow-xl mt-8 overflow-hidden">
          <img
            src={pageData.images.whyRiikka2}
            alt="Mansikkasanko"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <div class="lg:w-1/2 space-y-6">
        <h2 class="text-3xl font-bold leading-tight">
          {pageData.whyRiikka.heading}
        </h2>
        {
          pageData.whyRiikka.paragraphs.map((p) => (
            <p class="text-lg text-slate-700">{p}</p>
          ))
        }
        <a
          href={pageData.whyRiikka.ctaHref}
          class="mt-4 inline-flex items-center gap-2 px-8 py-3 bg-primary text-white font-bold rounded-lg hover:bg-primary/90 transition-all no-underline"
        >
          {pageData.whyRiikka.ctaText}
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
